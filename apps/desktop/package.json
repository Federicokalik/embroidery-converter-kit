{
  "name": "desktop",
  "license": "MIT",
  "private": true,
  "version": "0.2.0",
  "description": "Ricuci — embroidery file converter (desktop)",
  "author": "Federico Kalik",
  "main": "main.js",
  "scripts": {
    "sync-renderer": "node scripts/sync-renderer.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "dev.federicokalik.ricuci",
    "productName": "Ricuci",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Federicokalik",
        "repo": "embroidery-converter-kit"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Ricuci-Windows.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ricuci",
      "uninstallDisplayName": "Ricuci"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Ricuci-macOS.dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    },
    "appImage": {
      "artifactName": "Ricuci-Linux.AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
